# Copiez ce fichier vers .env et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env

# Mot de passe backoffice (min. 12 caractères) — obligatoire
FANG_ADMIN_PASSWORD=

# Compte propriétaire initial (créé au premier démarrage, sync au redémarrage)
FANG_ADMIN_EMAIL=admin@fang.studio
FANG_ADMIN_NAME=Administrateur FANG

# Port du serveur API (défaut 5170)
FANG_ADMIN_PORT=5170

# Origine autorisée pour CORS (URL du site en production)
FANG_CORS_ORIGIN=http://localhost:5173

# WhatsApp atelier (sans +)
VITE_WHATSAPP_ORDER=221000000000

# E-mail contact boutique
VITE_CONTACT_EMAIL=contact@fang.studio

# ─── SMTP (Nodemailer) — pour confirmations, reset mdp, notifications ───
FANG_SMTP_HOST=
FANG_SMTP_PORT=587
FANG_SMTP_USER=
FANG_SMTP_PASS=
FANG_SMTP_FROM="FANG Atelier <contact@fang.studio>"
FANG_SMTP_SECURE=false

# ─── Paiements en ligne ───
# Choisir la passerelle active dans /admin/parametres → onglet "Paiement en ligne".
# Le choix admin n'est appliqué QUE si les clés correspondantes sont présentes ci-dessous.

# Autoriser un paiement simulé en dev quand aucun provider n'est configuré
CHECKOUT_ALLOW_SIMULATED_PAYMENT=false

# ─── PayTech (Sénégal) ───
PAYTECH_ENABLED=true
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test                                       # test | prod
PAYTECH_IPN_URL=https://votre-site/api/store/checkout/paytech/ipn
PAYTECH_SUCCESS_URL=https://votre-site/api/store/checkout/paytech/return
PAYTECH_CANCEL_URL=https://votre-site/api/store/checkout/paytech/cancel

# ─── PayDunya (multi-pays) ───
PAYDUNYA_ENABLED=true
PAYDUNYA_MODE=test                                     # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=FANG
PAYDUNYA_CALLBACK_URL=https://votre-site/api/store/checkout/paydunya/callback
PAYDUNYA_RETURN_URL=https://votre-site/api/store/checkout/paydunya/return
PAYDUNYA_CANCEL_URL=https://votre-site/api/store/checkout/paydunya/cancel

# ─── Webhooks génériques (HMAC SHA256) pour intégrations futures ───
FANG_WEBHOOK_SECRET_STRIPE=
FANG_WEBHOOK_SECRET_WAVE=
FANG_WEBHOOK_SECRET_ORANGE_MONEY=

# ─── (Optionnel) Stripe / Wave / Orange Money keys pour intégrations directes ───
FANG_STRIPE_SECRET_KEY=
FANG_STRIPE_PUBLISHABLE_KEY=
FANG_WAVE_API_KEY=
FANG_ORANGEMONEY_API_KEY=

# Backup : mettre à 1 pour désactiver les backups quotidiens automatiques
FANG_DISABLE_BACKUPS=0

