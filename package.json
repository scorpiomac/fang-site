{
  "name": "fang-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,admin -c cyan,magenta \"npm:dev:vite\" \"npm:admin\"",
    "dev:vite": "vite",
    "admin": "node server/admin.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "sync:media": "bash scripts/sync-public-media.sh",
    "sync:saison1": "node scripts/sync-saison1-media.mjs",
    "test": "node scripts/test-runner.mjs",
    "test:unit": "node scripts/test-runner.mjs --unit-only",
    "test:integration": "node scripts/test-runner.mjs --integration-only",
    "test:smoke": "node scripts/test-all.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "backup:create": "node scripts/backup.mjs create",
    "backup:list": "node scripts/backup.mjs list",
    "backup:restore": "node scripts/backup.mjs restore"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^11.15.0",
    "gsap": "^3.12.5",
    "helmet": "^8.2.0",
    "lenis": "^1.1.18",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}
